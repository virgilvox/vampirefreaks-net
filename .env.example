# Copy to .env and fill in. docker-compose provides a matching local Postgres.
DATABASE_URL=postgres://jig:jig@localhost:5432/jig

# better-auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
NUXT_PUBLIC_AUTH_BASE_URL=http://localhost:3000

# GitHub OAuth (https://github.com/settings/developers).
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth (optional, off until both values are set).
# Callback URL: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Resend). Without a key, reset and verification links log to the server
# console so dev still works. Set EMAIL_FROM to an address on a domain verified
# in Resend; onboarding@resend.dev only delivers to the Resend account owner.
RESEND_API_KEY=
EMAIL_FROM="JIG <onboarding@resend.dev>"

# Require a verified email before sign-in. Off by default. Turn on with Resend
# configured.
REQUIRE_EMAIL_VERIFICATION=false

# Optional: which account `npm run db:seed` attaches sample data to. Defaults to
# the most recently created user.
# SEED_USER_EMAIL=you@example.com
